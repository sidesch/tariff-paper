    stats(N r2, fmt(%9.0fc %9.3f) labels("Observations" "R-squared")) ///
    addnotes("Standard errors clustered by 3-digit SCIAN industry." ///
             "Outcome is log ratio of 90th to 10th income percentile" ///
             "within each industry-year cell." ///
             "Base year is 2017.")

